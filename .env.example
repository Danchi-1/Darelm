# Darelm Production Environment Variables
# Copy this file to .env on your ECS server and fill in the actual values

# Database
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/dbname

# Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SECRET_KEY=generate_a_very_long_secure_random_string

# Mail
MAIL_USERNAME=your-smtp-email@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@darelm.com

# AI Exec
E2B_API_KEY=e2b_your_production_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Keep-Alive Heartbeat
ENABLE_KEEP_ALIVE=true
RENDER_EXTERNAL_URL=https://darelm.onrender.com

# Security
# Set this to the frontend URL hosted on OSS (e.g., https://app.darelm.com)
CORS_ORIGINS=["https://app.darelm.com"]

# Storage (Neon Object Storage / S3-compatible)
# In Neon Console: Storage -> Connect
S3_ENDPOINT_URL=https://...
S3_ACCESS_KEY_ID=your-neon-access-key-id
S3_SECRET_ACCESS_KEY=your-neon-secret-access-key
S3_BUCKET_NAME=darelm-s3bucket
S3_REGION=us-east-1

# Storage (Alibaba Cloud OSS - Legacy fallback)
# ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-secret-key
# ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# ALIYUN_OSS_BUCKET_NAME=your-bucket-name
